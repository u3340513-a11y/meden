Options -MultiViews
RewriteEngine On

# Authorization header'ı koru (Bearer token için)
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# /api/* isteklerini doğrudan api/index.php'ye yönlendir
RewriteCond %{REQUEST_URI} ^/api [NC]
RewriteRule ^ api/index.php [L,QSA]

# /storage/* dosyalarını api_backend/storage/app/public/'e yönlendir
RewriteRule ^storage/(.*)$ api_backend/storage/app/public/$1 [L]

# Gerçek dosya/klasör varsa direkt sun
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Diğer tüm istekleri React SPA'ya yönlendir
RewriteRule ^ /index.html [L]

